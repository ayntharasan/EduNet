# Green Campus Sustainability Auditor — Environment Configuration
# Copy this file to .env and adjust values. Never commit .env to version control.

# Application
APP_NAME="Green Campus Sustainability Auditor"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./green_campus.db

# API
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# File uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

# Emission factors (kgCO2e per kWh)
# Default: India CEA grid emission factor 2022-23 (0.716 kgCO2e/kWh)
# Source: CEA CO2 Baseline Database for the Indian Power Sector, Version 18
# Update this with the most current official factor for your region.
DEFAULT_EMISSION_FACTOR=0.716
EMISSION_FACTOR_SOURCE="CEA CO2 Baseline Database Version 18 (2022-23)"
EMISSION_FACTOR_UNIT="kgCO2e/kWh"

# Optional: Ollama local LLM (leave blank to disable)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_ENABLED=false

# Demo data
DEMO_SEED=42
DEMO_CAMPUS_NAME="Green Valley University (Demo)"
